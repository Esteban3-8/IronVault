<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.myapplication">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="IronVault"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Pantalla de carga inicial (Splash) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".BusinessRulesActivity"
            android:exported="false" />
        <activity
            android:name=".GuestModeActivity"
            android:exported="false" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".MasterPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".UnlockVaultActivity"
            android:exported="false" />

        <!-- Actividades agregadas por ti -->
        <activity
            android:name=".CredentialDetailActivity"
            android:exported="false" />
        <activity
            android:name=".EditCredentialActivity"
            android:exported="false" />
        <activity
            android:name=".NuevaCredencialActivity"
            android:exported="false" />
        <activity
            android:name=".PasswordGeneratorActivity"
            android:exported="false" />

        <!-- Actividades agregadas por tu equipo -->
        <activity
            android:name=".SecurityActivity"
            android:exported="false" />
        <activity
            android:name=".ChangeMasterKeyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AccessHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VaultSecurityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PrincipalPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NuevaCategoriaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>