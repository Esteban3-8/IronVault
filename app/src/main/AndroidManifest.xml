<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permiso necesario para conexión a internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="IronVault"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Pantalla de carga inicial (Splash) con su tema seguro -->
        <activity
            android:name=".SplashActivity"
            android:theme="@style/Theme.App.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".BusinessRulesActivity"
            android:exported="false" />
        <activity
            android:name=".GuestModeActivity"
            android:exported="false" />

        <!-- Pantalla para solicitar la recuperación por correo -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla de verificación de código OTP -->
        <activity
            android:name=".VerifyCodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Pantalla para restablecer contraseña -->
        <activity
            android:name=".ResetPasswordActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MasterPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".UnlockVaultActivity"
            android:exported="false" />

        <!-- Actividades de Credenciales -->
        <activity
            android:name=".CredentialDetailActivity"
            android:exported="false" />
        <activity
            android:name=".EditCredentialActivity"
            android:exported="false" />
        <activity
            android:name=".NuevaCredencialActivity"
            android:exported="false" />
        <activity
            android:name=".PasswordGeneratorActivity"
            android:exported="false" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Actividad de seguridad -->
        <activity
            android:name=".SecurityActivity"
            android:exported="false" />

        <!-- Actividades de ajustes y configuraciones -->
        <activity
            android:name=".ChangeMasterKeyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AccessHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VaultSecurityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PrincipalPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NuevaCategoriaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdministrarCategoriasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditarCategoriaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>