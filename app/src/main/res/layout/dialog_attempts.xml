<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_auto_lock"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Asa -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@color/border_option_card" />

    <!-- Opción seleccionada -->
    <TextView
        android:id="@+id/opt3a"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_option_selected"
        android:fontFamily="@font/inter_bold"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="3 Intentos"
        android:textColor="@color/orange_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/opt5a"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="5 Intentos"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/opt7a"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="7 Intentos"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/optNever"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:text="Nunca"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <!-- Cancelar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCancelSheet"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#282A30"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>