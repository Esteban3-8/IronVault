<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp"
    tools:context=".PrincipalPasswordActivity">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="Volver"
        android:src="@drawable/flecha"
        app:layout_constraintBottom_toBottomOf="@id/tvPrincipalTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvPrincipalTitle" />

    <TextView
        android:id="@+id/tvPrincipalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_bold"
        android:text="Contraseña principal"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvPrincipalSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="sans-serif-medium"
        android:text="Por seguridad, confirma tu identidad para cambiar tu contraseña maestra actual."
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPrincipalTitle" />

    <!-- Campo: contraseña actual -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCurrent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#1B1D22"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2C303B"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPrincipalSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Contraseña actual"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPassword"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="12345678" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivToggleCurrent"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Mostrar contraseña"
                android:src="@drawable/ojo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Campo: nueva contraseña -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNew"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1B1D22"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2C303B"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCurrent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Nueva contraseña"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPassword"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="12345678" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivToggleNew"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Mostrar contraseña"
                android:src="@drawable/ojo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Campo: confirmar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConfirm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1B1D22"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2C303B"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardNew">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Confirmar nueva contraseña"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:inputType="textPassword"
                    android:paddingTop="4dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    tools:text="12345678" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivToggleConfirm"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Mostrar contraseña"
                android:src="@drawable/ojo" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Barra de fortaleza -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStrength"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="@color/bg_icon_box"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardConfirm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="10">

            <View
                android:id="@+id/viewStrengthFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:background="@color/green_accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvStrengthLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="Fortaleza Alta"
        android:textColor="@color/green_accent"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardStrength" />

    <!-- Botón -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnChangePrincipal"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_primary_button"
        android:fontFamily="@font/inter_bold"
        android:text="Cambiar contraseña principal"
        android:textAllCaps="false"
        android:textColor="@color/bg_main"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStrengthLabel" />

    <TextView
        android:id="@+id/tvPrincipalFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="IronVault • seguridad cifrada AES-256"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnChangePrincipal" />

</androidx.constraintlayout.widget.ConstraintLayout>