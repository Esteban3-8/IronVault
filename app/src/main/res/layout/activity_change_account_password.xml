<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo centrado -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="IronVault"
            android:src="@drawable/logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="IronVault"
            android:textColor="#E8873E"
            android:textSize="24sp" />

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="Contraseña de la cuenta"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/change_account_password_subtitle"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />

        <!-- Contraseña actual -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/change_account_password_hint_current"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etCurrentPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/change_account_password_hint_current"
                android:inputType="textPassword"
                android:maxLines="1"
                android:saveEnabled="false"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A7A"
                android:textSize="13.5sp" />

            <ImageView
                android:id="@+id/ivToggleCurrent"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Ver contraseña"
                android:src="@drawable/ojo_cerrado" />
        </LinearLayout>

        <!-- Nueva contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/change_account_password_hint_new"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/change_account_password_hint_new"
                android:inputType="textPassword"
                android:maxLines="1"
                android:saveEnabled="false"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A7A"
                android:textSize="13.5sp" />

            <ImageView
                android:id="@+id/ivToggleNew"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Ver contraseña"
                android:src="@drawable/ojo_cerrado" />
        </LinearLayout>

        <!-- Confirmar nueva contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/change_account_password_hint_confirm"
            android:textColor="#9A9A9A"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/change_account_password_hint_confirm"
                android:inputType="textPassword"
                android:maxLines="1"
                android:saveEnabled="false"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A7A"
                android:textSize="13.5sp" />

            <ImageView
                android:id="@+id/ivToggleConfirm"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Ver contraseña"
                android:src="@drawable/ojo_cerrado" />
        </LinearLayout>

        <!-- Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Botón cambiar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:text="@string/change_account_password_btn"
            android:textAllCaps="false"
            android:textColor="#23202A"
            android:textSize="14.5sp" />

        <!-- Enlace de recuperación -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/change_account_password_forgot"
            android:textColor="#E08238"
            android:textSize="13sp" />

        <!-- Botón volver -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary_button"
            android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium"
            android:text="Volver"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
