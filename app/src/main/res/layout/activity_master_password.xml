<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:padding="24dp">

    <!-- Flecha Atrás -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:contentDescription="Volver"
        android:src="@drawable/flecha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Icono de Escudo Superior -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardShield"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#1F222B"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="Escudo de seguridad"
            android:src="@drawable/escudo"
            app:tint="#F2A25C" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Título y Subtítulo -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-medium"
        android:text="Crea tu contraseña maestra"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardShield" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Ya iniciaste sesión. Ahora crea la llave que protegerá tu bóveda."
        android:textAlignment="center"
        android:textColor="#9A9A9A"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Alerta de Advertencia -->
    <LinearLayout
        android:id="@+id/layoutWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_warning_border"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:src="@android:drawable/stat_notify_error"
            app:tint="#FCA5A5" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Si la olvidas, NO se podrá recuperar bajo ningún motivo."
            android:textColor="#FCA5A5"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Campo de texto: Nueva contraseña maestra -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNewPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1B1D22"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2C303B"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/layoutWarning">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/ivToggleNewPassword"
                android:autofillHints="password"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Nueva contraseña maestra"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A7A"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivToggleNewPassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Mostrar contraseña"
                android:src="@drawable/ojo" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Campo de texto: Confirma contraseña maestra -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardConfirmPassword"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1B1D22"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2C303B"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardNewPassword">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/ivToggleConfirmPassword"
                android:autofillHints="password"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Confirma contraseña maestra"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#7A7A7A"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/ivToggleConfirmPassword"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Mostrar contraseña"
                android:src="@drawable/ojo" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Barras Indicadoras de Seguridad -->
    <LinearLayout
        android:id="@+id/layoutStrengthBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/cardConfirmPassword">

        <View
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="#3A3F4B" />

        <View
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="#3A3F4B" />

        <View
            android:layout_width="0dp"
            android:layout_height="3.5dp"
            android:layout_weight="1"
            android:background="#3A3F4B" />
    </LinearLayout>

    <!-- Texto de ayuda dinámico de seguridad -->
    <TextView
        android:id="@+id/tvStrengthHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="Mínimo 6 caracteres"
        android:textColor="#9CA3AF"
        android:textSize="11.5sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutStrengthBars" />

    <!-- Botón Principal Crear Bóveda -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCreateVault"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        app:cardBackgroundColor="#E8873E"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvStrengthHint">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Crear bóveda"
            android:textColor="#23202A"
            android:textSize="14.5sp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Texto Informativo Inferior -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Si la olvidas, no podremos recuperarla."
        android:textColor="#7A7A7A"
        android:textSize="11.5sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateVault" />

</androidx.constraintlayout.widget.ConstraintLayout>