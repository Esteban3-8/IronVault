<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14151A"
    android:paddingHorizontal="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="36dp">

    <!-- Flecha de retroceso -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:clickable="true"
        android:focusable="true"
        android:src="@drawable/flecha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <!-- Título superior centrado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:text="Restablecer contraseña"
        android:textColor="#AC9CAF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Contenido central -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Tarjeta del icono -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            app:cardBackgroundColor="#1F222B"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:contentDescription="Icono de restablecimiento"
                android:src="@drawable/ic_reset_password"
                app:tint="#F2A25C" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/inter_bold"
            android:text="Nueva contraseña"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Ingresa y confirma tu nueva clave de acceso para asegurar tu cuenta."
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <!-- Campo: Nueva contraseña -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1B1D22"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#2C303B"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="18dp">

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/ivTogglePassword1"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="Nueva contraseña"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5A5C62"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword1"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Mostrar contraseña"
                    android:src="@drawable/ojo" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Campo: Confirmar nueva contraseña -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#1B1D22"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#2C303B"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="18dp">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/ivTogglePassword2"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="Confirmar nueva contraseña"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5A5C62"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivTogglePassword2"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Mostrar contraseña"
                    android:src="@drawable/ojo" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Guardar contraseña -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSavePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="@font/inter_bold"
            android:text="Guardar contraseña"
            android:textAllCaps="false"
            android:textColor="#14151A"
            android:textSize="14sp"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>