<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#14151A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp">

        <!-- Botón Volver -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/flecha"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#FFFFFF" />

        <!-- Título principal -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="Crea tu cuenta"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Solo toma un minuto."
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Campo: Nombre completo -->
        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_security_badge"
            android:hint="Nombre completo"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle" />

        <!-- Campo: Correo + Botón Verificar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutEmailContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_security_badge"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/etFullName">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="usuario@correo.com"
                android:inputType="textEmailAddress"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/btnVerify"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Botón Verificar con borde naranja exacto -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVerify"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_orange_border"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:text="Verificar"
                android:textAllCaps="false"
                android:textColor="#E08A3C"
                android:textSize="12sp"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Indicador: Correo verificado -->
        <LinearLayout
            android:id="@+id/layoutEmailVerified"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutEmailContainer">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Correo verificado"
                android:textColor="#8FC954"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Campo: Contraseña -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPasswordContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_security_badge"
            android:paddingHorizontal="16dp"
            app:layout_constraintTop_toBottomOf="@id/layoutEmailVerified">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/ivTogglePassword"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ojo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#9CA3AF" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Barras de Nivel de Seguridad de Contraseña -->
        <LinearLayout
            android:id="@+id/layoutPasswordStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/layoutPasswordContainer">

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#8FC954" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#8FC954" />

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:background="#374151" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStrengthHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Media - Añade un símbolo"
            android:textColor="#8FC954"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPasswordStrength" />

        <!-- Campo: Confirma tu contraseña -->
        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_security_badge"
            android:hint="Confirma tu contraseña"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvStrengthHint" />

        <!-- Términos y Condiciones -->
        <LinearLayout
            android:id="@+id/layoutTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPassword">

            <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@drawable/custom_checkbox"
                app:buttonTint="#E08A3C"
                app:useMaterialThemeColors="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Acepto los "
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Términos"
                android:textColor="#E08A3C"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" y la "
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Política de Privacidad"
                android:textColor="#E08A3C"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Botón: Crear cuenta -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_primary_button"
            android:fontFamily="sans-serif-medium"
            android:text="Crear cuenta"
            android:textAllCaps="false"
            android:textColor="#14151A"
            android:textSize="15sp"
            app:backgroundTint="@null"
            app:layout_constraintTop_toBottomOf="@id/layoutTerms" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>