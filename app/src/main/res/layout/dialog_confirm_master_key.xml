<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="36dp">

    <!-- Indicador superior -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#374151" />

    <!-- Ícono de candado -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="start"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#1F2937"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Candado"
            android:src="@drawable/ic_security_lock"
            app:tint="@color/orange_primary" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Título -->
    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/inter_bold"
        android:text="Confirma tu identidad"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <!-- Subtítulo dinámico: se actualiza según la acción -->
    <TextView
        android:id="@+id/tvConfirmSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="Ingresa tu contraseña maestra para continuar."
        android:textColor="@color/text_muted"
        android:textSize="13sp" />

    <!-- Campo de contraseña maestra -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bg_dark_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/etMasterKeyInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Contraseña maestra"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivToggleMasterKey"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Ver contraseña"
                android:src="@drawable/ojo_cerrado" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Mensaje de error (oculto por defecto) -->
    <TextView
        android:id="@+id/tvMasterKeyError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="Contraseña incorrecta. Inténtalo de nuevo."
        android:textColor="#EF4444"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Botón confirmar -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmMasterKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_primary_button"
        android:fontFamily="@font/inter_bold"
        android:text="Confirmar"
        android:textAllCaps="false"
        android:textColor="@color/bg_main"
        android:textSize="14sp"
        app:backgroundTint="@null" />

    <!-- Botón cancelar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCancelMasterKey"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#282A30"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
