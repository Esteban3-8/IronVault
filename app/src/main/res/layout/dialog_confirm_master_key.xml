<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <!-- Indicador superior -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#374151" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvConfirmTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/inter_bold"
        android:text="Confirma tu identidad"
        android:textColor="@color/text_primary"
        android:textSize="17sp" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tvConfirmSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fontFamily="sans-serif-medium"
        android:text="Ingresa tu contraseña maestra para continuar."
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Campo de contraseña maestra -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:cardBackgroundColor="@color/bg_dark_card"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_color"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/etMasterKeyInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Contraseña maestra"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivToggleMasterKey"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Ver contraseña"
                android:src="@drawable/ojo_cerrado" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Error -->
    <TextView
        android:id="@+id/tvMasterKeyError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Contraseña incorrecta. Inténtalo de nuevo."
        android:textColor="#EF4444"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Botón confirmar -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmMasterKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_primary_button"
        android:fontFamily="@font/inter_bold"
        android:text="Confirmar"
        android:textAllCaps="false"
        android:textColor="@color/bg_main"
        android:textSize="14sp"
        app:backgroundTint="@null" />

    <!-- Botón cancelar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnCancelMasterKey"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#282A30"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="Cancelar"
            android:textColor="@color/text_soft"
            android:textSize="14sp" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
