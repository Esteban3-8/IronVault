<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_main" android:padding="20dp">
    <ImageView android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="12dp" android:contentDescription="Volver" android:src="@drawable/flecha"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/tvHistoryTitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold" android:text="Historial de accesos" android:textSize="20sp"
        android:textColor="@color/text_primary" android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/btnBack" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" app:layout_constraintBottom_toBottomOf="@id/btnBack" />
    <TextView android:id="@+id/tvHistorySubtitle" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium" android:textSize="12sp"
        android:textColor="@color/text_muted" android:gravity="center"
        android:text="Dispositivos que esta versión de IronVault registró al autenticar tu cuenta. No indica sesiones abiertas ni confirma que se haya desbloqueado la bóveda."
        app:layout_constraintTop_toBottomOf="@id/btnBack" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp" android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/tvHistorySubtitle" app:layout_constraintBottom_toTopOf="@id/btnRefreshHistory"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/historyStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_muted"
                android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/historyProgress" android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/historyRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMoreHistory"
                android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp"
                android:background="@drawable/bg_secondary_button" app:backgroundTint="@null" android:text="Ver más accesos"
                android:textColor="@color/text_primary" android:textAllCaps="false" android:visibility="gone" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="Los nombres de los dispositivos son informados por la app. No se recopila ubicación. El historial se conserva para facilitar la revisión de accesos."
                android:fontFamily="sans-serif-medium" android:textSize="12sp" android:textColor="@color/text_muted" />
        </LinearLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnRefreshHistory" android:layout_width="0dp"
        android:layout_height="54dp" android:background="@drawable/bg_primary_button" app:backgroundTint="@null"
        android:fontFamily="@font/inter_bold" android:text="Actualizar historial" android:textAllCaps="false"
        android:textColor="@color/bg_main" android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
