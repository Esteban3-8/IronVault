<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121417"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Flecha Atrás: solo visible cuando NO viene de bloqueo -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:contentDescription="Volver"
            android:src="@drawable/flecha"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ══════════════════════════════════════════════════════
             CADENA VERTICAL packed: escudo → título → subtítulo
             → aviso → etiqueta → campo → botón → pie
             ══════════════════════════════════════════════════════ -->

        <!-- Escudo (cabeza de la cadena) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardShield"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardBackgroundColor="#1F222B"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toTopOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:contentDescription="Escudo de seguridad"
                android:src="@drawable/escudo"
                app:tint="#F2A25C" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ingresa tu contraseña maestra"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardShield" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ya iniciaste sesión. Ahora ingresa la llave que protege tu bóveda."
            android:textAlignment="center"
            android:textColor="#9A9A9A"
            android:textSize="13sp"
            app:layout_constraintBottom_toTopOf="@id/layoutWarning"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Alerta de advertencia (siempre visible) -->
        <LinearLayout
            android:id="@+id/layoutWarning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_warning_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:layout_constraintBottom_toTopOf="@id/lblPassword"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="10dp"
                android:src="@android:drawable/stat_notify_error"
                app:tint="#FCA5A5" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Si la olvidas, NO se podrá recuperar bajo ningún motivo."
                android:textColor="#FCA5A5"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Panel de bloqueo por intentos: FUERA de la cadena, flota encima -->
        <!-- Visible solo cuando hay bloqueo activo; gone = no ocupa espacio -->
        <LinearLayout
            android:id="@+id/layoutLockout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_warning_border"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutWarning">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginBottom="8dp"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#FCA5A5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Bóveda bloqueada temporalmente"
                android:textColor="#FCA5A5"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_bold"
                android:text="00:30"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Demasiados intentos fallidos"
                android:textColor="#9A9A9A"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Etiqueta del campo (cadena continúa desde layoutWarning) -->
        <TextView
            android:id="@+id/lblPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Contraseña maestra"
            android:textAlignment="viewStart"
            android:textColor="#9A9A9A"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/cardMasterPassword"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutWarning" />

        <!-- Campo contraseña maestra -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMasterPassword"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1B1D22"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#2C303B"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toTopOf="@id/btnUnlockVault"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblPassword">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/etMasterPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/ivToggleMasterPassword"
                    android:autofillHints="password"
                    android:background="@null"
                    android:fontFamily="sans-serif-medium"
                    android:hint="••••••••••••"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#7A7A7A"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/ivToggleMasterPassword"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Mostrar contraseña"
                    android:src="@drawable/ojo" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón desbloquear -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnUnlockVault"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#E8873E"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toTopOf="@id/tvFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardMasterPassword">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Iniciar la bóveda"
                android:textColor="#23202A"
                android:textSize="14.5sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Pie de página (final de la cadena) -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="Si la olvidas, no podremos recuperarla."
            android:textColor="#7A7A7A"
            android:textSize="11.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnUnlockVault" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
