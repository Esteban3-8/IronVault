<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- ScrollView que contiene todo el contenido deslizable -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Título de la pantalla -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="@font/inter_bold"
                android:text="@string/generator_title"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <!-- Tarjeta de Contraseña Generada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_password_border"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="18dp">

                <TextView
                    android:id="@+id/tvGeneratedPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:textDirection="ltr"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvStrengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Barras de Fortaleza con ancho personalizado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/viewBar1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_strength_bar_thin" />

                <View
                    android:id="@+id/viewBar2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="4dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_strength_bar_thin" />

                <View
                    android:id="@+id/viewBar3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_strength_bar_thin" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCopy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_card_rounded"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/generator_copy"
                    android:textAllCaps="false"
                    android:textColor="@color/text_soft" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGenerateNew"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:background="@drawable/bg_card_rounded"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/generator_regenerate"
                    android:textAllCaps="false"
                    android:textColor="@color/text_soft" />
            </LinearLayout>

            <!-- Control deslizante (SeekBar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/generator_length"
                    android:textColor="#D1D5DB"
                    android:textSize="14sp" />

                <SeekBar
                    android:id="@+id/seekBarLength"
                    android:contentDescription="@string/generator_length"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:max="28"
                    android:minHeight="2dp"
                    android:maxHeight="2dp"
                    android:progress="12"
                    android:progressDrawable="@drawable/bg_seekbar_thick"
                    android:thumb="@drawable/vector_5" />

                <TextView
                    android:id="@+id/tvLengthValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="16"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Lista de Switches -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_row"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:orientation="vertical">

                <!-- Mayúsculas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:labelFor="@id/switchUppercase"
                        android:text="@string/generator_uppercase"
                        android:textColor="#D1D5DB"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchUppercase"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:checked="true"
                        android:background="@drawable/switch_custom_selector"
                        android:thumb="@null"
                        app:track="@null" />
                </LinearLayout>

                <!-- Minúsculas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:labelFor="@id/switchLowercase"
                        android:text="@string/generator_lowercase"
                        android:textColor="#D1D5DB"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchLowercase"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:checked="true"
                        android:background="@drawable/switch_custom_selector"
                        android:thumb="@null"
                        app:track="@null" />
                </LinearLayout>

                <!-- Números -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:labelFor="@id/switchNumbers"
                        android:text="@string/generator_numbers"
                        android:textColor="#D1D5DB"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNumbers"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:checked="true"
                        android:background="@drawable/switch_custom_selector"
                        android:thumb="@null"
                        app:track="@null" />
                </LinearLayout>

                <!-- Símbolos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:labelFor="@id/switchSymbols"
                        android:text="@string/generator_symbols"
                        android:textColor="#D1D5DB"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchSymbols"
                        android:layout_width="52dp"
                        android:layout_height="32dp"
                        android:background="@drawable/switch_custom_selector"
                        android:thumb="@null"
                        app:track="@null" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAcceptPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:background="@drawable/bg_button_orange"
                android:fontFamily="sans-serif-medium"
                android:text="@string/generator_accept"
                android:textAllCaps="false"
                android:textColor="#121212"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Barra de Navegación Inferior -->
    <include
        android:id="@+id/bottomNavContainer"
        layout="@layout/layout_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>