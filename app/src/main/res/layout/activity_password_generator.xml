<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    android:padding="20dp">

    <!-- Contenedor principal con margen superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <!-- Barra superior: Flecha y Título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/flecha" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="Generador de contraseñas"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Tarjeta de Contraseña Generada -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_password_border"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/tvGeneratedPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="K9#mX2!pL9$w"
                android:textColor="#8FC954"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Fortaleza: Excelente (128 bits de entropía)"
                android:textColor="#9CA3AF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Barras de Fortaleza con ancho personalizado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_strength_bar_thin" />

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_strength_bar_thin" />

            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_strength_bar_thin" />
        </LinearLayout>

        <!-- Botón Copiar al Portapapeles -->
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="200dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_card_rounded"
            android:fontFamily="sans-serif-medium"
            android:text="📋  Copiar al Portapapeles"
            android:textAllCaps="false"
            android:textColor="#D1D5DB"
            android:textSize="14sp" />

        <!-- Control deslizante (SeekBar) con su thumb y progreso personalizado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Longitud"
                android:textColor="#D1D5DB"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBarLength"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:max="32"
                android:minHeight="2dp"
                android:maxHeight="2dp"
                android:progress="16"
                android:progressDrawable="@drawable/bg_seekbar_thick"
                android:thumb="@drawable/vector_5" />

            <TextView
                android:id="@+id/tvLengthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="16"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Lista de Switches con tamaño y alineación correcta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <!-- Mayúsculas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Mayúsculas (A-Z)"
                    android:textColor="#D1D5DB"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchUppercase"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:background="@drawable/switch_custom_selector"
                    android:thumb="@null"
                    app:track="@null" />
            </LinearLayout>

            <!-- Minúsculas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Minúsculas (a-z)"
                    android:textColor="#D1D5DB"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchLowercase"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:background="@drawable/switch_custom_selector"
                    android:thumb="@null"
                    app:track="@null" />
            </LinearLayout>

            <!-- Números -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Números (0-9)"
                    android:textColor="#D1D5DB"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNumbers"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:checked="true"
                    android:background="@drawable/switch_custom_selector"
                    android:thumb="@null"
                    app:track="@null" />
            </LinearLayout>

            <!-- Símbolos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Símbolos (!_$%&amp;)"
                    android:textColor="#D1D5DB"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSymbols"
                    android:layout_width="52dp"
                    android:layout_height="32dp"
                    android:background="@drawable/switch_custom_selector"
                    android:thumb="@null"
                    app:track="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botones de Acción Finales -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGenerateNew"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_rounded"
            android:fontFamily="sans-serif-medium"
            android:text="Generar de nuevo"
            android:textAllCaps="false"
            android:textColor="#D1D5DB"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAcceptPassword"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_orange"
            android:fontFamily="sans-serif-medium"
            android:text="Continuar con esta contraseña"
            android:textAllCaps="false"
            android:textColor="#121212"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>